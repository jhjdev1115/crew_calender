# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.jks
*.keystore
/android/keystore.properties
/android/app/google-services.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/tsconfig.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/output/
/tmp/
/work/
/.npm-cache/

# Android local and generated files
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/key.properties
/android/app/key.properties

# iOS local and generated files
/ios/App/Pods/
/ios/App/DerivedData/
/ios/App/App.xcworkspace/xcuserdata/
/ios/App/App.xcodeproj/xcuserdata/
*.xcuserstate
