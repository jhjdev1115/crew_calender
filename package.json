{
  "name": "crewsync-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy:cloudflare": "npm run build && wrangler deploy --config wrangler.jsonc",
    "db:migrate:cloudflare": "wrangler d1 migrations apply crewsync-production --remote --config wrangler.jsonc",
    "secrets:cloudflare": "node scripts/configure-cloudflare-secrets.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern android/app/src/main/assets",
    "db:generate": "drizzle-kit generate",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "cap sync android && cd android && gradlew.bat assembleDebug",
    "android:build:release": "cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.17.1",
    "jose": "^6.2.8",
    "next": "16.2.6",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
