FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
INVITE_PEPPER=replace-with-a-long-random-secret
VAPID_PUBLIC_KEY=replace-with-your-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-your-private-vapid-key
